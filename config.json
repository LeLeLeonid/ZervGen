{
    "provider": "openrouter",
    "max_steps": 50,
    "tool_timeout": 60,
    "delegation_timeout": 300,
    "provider_timeout": 120,
    "debug_mode": true,
    "mcp_enabled": true,
    "mcp_expose_direct_tools": false,
    "mcp_servers": {
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "env": {},
            "enabled": true
        },
        "git": {
            "command": "python",
            "args": [
                "-m",
                "mcp_server_git"
            ],
            "env": {},
            "enabled": true
        },
        "fetch": {
            "command": "python",
            "args": [
                "-m",
                "mcp_server_fetch"
            ],
            "env": {},
            "enabled": true
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": {},
            "enabled": true
        },
        "everything": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-everything"
            ],
            "env": {},
            "enabled": true
        },
        "puppeteer": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ],
            "env": {},
            "enabled": true
        },
        "roblox_studio": {
            "command": "cmd.exe",
            "args": [
                "/c",
                "cd /d %LOCALAPPDATA%\\Roblox && mcp.bat"
            ],
            "env": {},
            "enabled": true
        }
    },
    "allowed_directories": [
        "./tmp",
        "C:/Users/Public"
    ],
    "pollinations": {
        "text_model": "openai",
        "image_model": "flux",
        "audio_model": "openai-audio",
        "voice": "nova",
        "reasoning_effort": "minimal",
        "image_width": 1024,
        "image_height": 1024,
        "output_path": "tmp"
    },
    "gemini": {
        "model": "gemini-2.0-flash",
        "temperature": 0.7
    },
    "openrouter": {
        "model": "~deepseek/deepseek-v4-flash-latest",
        "vision_model": "allenai/molmo-2-8b:free",
        "site_url": "https://github.com/LeLeLeonid/ZervGen",
        "app_name": "ZervGen"
    },
    "openai": {
        "model": "gpt-5.2"
    },
    "anthropic": {
        "model": "claude-sonnet-4.5"
    },
    "compatible_presets": {},
    "mode": "BUILD",
    "memory_enabled": true,
    "dream_enabled": true,
    "dream_interval": 1200,
    "accent_color": "red",
    "history_trim_enabled": true,
    "history_trim_size": 20,
    "critic_enabled": true,
    "critic_gate_threshold": 4.0,
    "min_session_grade": 3.0,
    "max_refine_rounds": 3,
    "checkpoints_enabled": false,
    "resume_enabled": true,
    "checkpoint_max_snapshots": 30,
    "trace_enabled": true,
    "external_skills_enabled": false,
    "external_skill_roots": [
        "tmp"
    ],
    "prompt_show_internal_skills": false,
    "prompt_show_external_skills": false,
    "prompt_auto_trigger_skills": false,
    "prompt_auto_trigger_external_skills": false,
    "prompt_show_mcp_tools": false,
    "prompt_max_chars": 14000,
    "prompt_memory_limit": 4,
    "prompt_peer_card_limit": 3,
    "prompt_project_rules_chars": 1800,
    "json_tool_fallback": true,
    "ptc_strict": true,
    "ptc_auto_detect": false,
    "legacy_shell_blocks_enabled": false,
    "max_tool_calls": 200,
    "max_file_writes": 20,
    "max_token_budget": 100000,
    "max_cost_usd": 0.0,
    "max_delegations": 12,
    "max_parallel_agents": 4,
    "max_retries": 3,
    "run_timeout": 1800,
    "tripwire_error_repeats": 3,
    "trace_capture_chars": 2000,
    "verification_commands": [],
    "heartbeat_enabled": false,
    "heartbeat_interval": 300,
    "peer_cards": {},
    "active_model_tier": "COOL",
    "model_tiers": {
        "LOW": {},
        "COOL": {},
        "APEX": {}
    }
}